# Choose one authentication method. Never commit a real key.

# Option A: Google AI Studio for local learning.
GEMINI_API_KEY=replace-with-your-key

# Option B: Vertex AI for approved organizational use.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=your-approved-location

# Change this only when your organization approves another Gemini model.
GEMINI_MODEL=gemini-flash-latest
